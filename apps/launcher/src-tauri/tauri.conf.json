{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROXemu",
  "version": "0.1.0",
  "identifier": "com.roxemu.app",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ROXemu",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0b0614"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ROXemu",
    "shortDescription": "Seus jogos, num lugar só.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
